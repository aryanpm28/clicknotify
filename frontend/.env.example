# Frontend (optional)
# VITE_API_BASE_URL=http://localhost:8080

# Must match the backend's API_KEY env var (security.api-key) or every
# request gets a 401.
VITE_API_KEY=dev-only-placeholder-key

# Note: the bot username is no longer needed here — the backend now builds
# the Telegram deep link itself (see telegram.bot.username in
# backend/application.properties) and returns it from POST /telegram/link.
